{
  "suite": "profile",
  "level": 1,
  "about": "Reading a type you have never seen. Every case supplies a type definition and asks a question a consumer needs answered without knowing the producer's vocabulary.",
  "cases": [
    {
      "id": "profile/unknown-name-is-readable",
      "level": 1,
      "op": "isComplete",
      "given": {
        "type": {
          "id": "t_errand",
          "name": "Errand",
          "fields": [
            {
              "key": "what",
              "kind": "text"
            },
            {
              "key": "by",
              "kind": "date"
            },
            {
              "key": "state",
              "kind": "enum",
              "options": [
                "open",
                "sorted",
                "abandoned"
              ]
            }
          ],
          "profiles": {
            "task": {
              "title": "what",
              "due": "by",
              "status": "state",
              "completeValues": [
                "sorted",
                "abandoned"
              ]
            }
          }
        },
        "object": {
          "type": "t_errand",
          "properties": {
            "what": "Post the forms",
            "by": "2026-09-01",
            "state": "open"
          }
        }
      },
      "expect": false,
      "why": "The consumer has never heard of an Errand and must not need to. Completion is read through the declared mapping, not inferred from a field called 'status' or a value called 'done'."
    },
    {
      "id": "profile/multiple-complete-values",
      "level": 1,
      "op": "isComplete",
      "inherit": "profile/unknown-name-is-readable",
      "given": {
        "object": {
          "type": "t_errand",
          "properties": {
            "state": "abandoned"
          }
        }
      },
      "expect": true,
      "why": "Completion is a set, not a single value. Abandoned counts as complete for this producer; a consumer must respect that rather than treating only the last option as done."
    },
    {
      "id": "profile/datespan-part-mapping",
      "level": 1,
      "op": "read",
      "given": {
        "type": {
          "id": "t_task",
          "fields": [
            {
              "key": "dates",
              "kind": "datespan",
              "startLabel": "Available",
              "endLabel": "Due"
            }
          ],
          "profiles": {
            "task": {
              "start": {
                "field": "dates",
                "part": "start"
              },
              "due": {
                "field": "dates",
                "part": "end"
              }
            }
          }
        },
        "object": {
          "properties": {
            "dates": {
              "start": "2026-08-25",
              "end": "2026-08-26"
            }
          }
        }
      },
      "args": {
        "key": "due"
      },
      "expect": "2026-08-26",
      "why": "One producer's compound field maps onto two of a profile's scalars. A consumer must follow the part mapping rather than assuming a field named 'due' exists, and must not assume the labels are Start and Due — they are producer text."
    },
    {
      "id": "profile/no-declaration-no-guessing",
      "level": 1,
      "op": "profilesOf",
      "given": {
        "type": {
          "id": "t_recipe",
          "name": "Recipe",
          "fields": [
            {
              "key": "title",
              "kind": "text"
            },
            {
              "key": "status",
              "kind": "enum",
              "options": [
                "todo",
                "done"
              ]
            }
          ],
          "profiles": {}
        }
      },
      "expect": [],
      "why": "This type has a field called status with a value called done and is still not a task. A consumer that infers task-ness from field names will import the user's recipe box into their to-do list. Absence of a declaration is information."
    },
    {
      "id": "profile/multiple-profiles",
      "level": 1,
      "op": "profilesOf",
      "given": {
        "type": {
          "id": "t_meeting",
          "name": "Meeting",
          "profiles": {
            "event": {
              "title": "subject",
              "start": {
                "field": "when",
                "part": "start"
              }
            },
            "note": {
              "title": "subject",
              "body": "minutes"
            }
          }
        }
      },
      "expect": [
        "event",
        "note"
      ],
      "why": "A type can satisfy several profiles at once. A calendar tool reads it as an event, a notes tool reads it as a note, and neither has to be told which the producer 'really' meant."
    },
    {
      "id": "profile/unknown-profile-name-ignored",
      "level": 1,
      "op": "profilesOf",
      "given": {
        "type": {
          "id": "t_thing",
          "profiles": {
            "task": {
              "title": "t"
            },
            "habit": {
              "streak": "s"
            }
          }
        }
      },
      "expect": [
        "task"
      ],
      "why": "Profiles outside the v0 vocabulary are ignored for consumption but must survive a round-trip. A producer experimenting with a habit profile loses nothing by declaring it, which is how a vocabulary grows without a committee."
    },
    {
      "id": "profile/mapping-names-a-real-field",
      "level": 1,
      "op": "validate",
      "given": {
        "type": {
          "id": "t_errand",
          "name": "Errand",
          "fields": [
            {
              "key": "what",
              "kind": "text"
            },
            {
              "key": "by",
              "kind": "date"
            }
          ],
          "profiles": {
            "task": {
              "title": "what",
              "due": "by",
              "status": "state",
              "completeValues": [
                "sorted"
              ]
            }
          }
        }
      },
      "expect": {
        "valid": false,
        "errors": [
          {
            "code": "profile.field-not-declared"
          }
        ]
      },
      "why": "A profile is the producer saying which of their fields is the due date, and it is the whole substance of level 1. Mapping `status` onto a field the type never declares reads as a declaration and delivers nothing: the consumer that trusts it gets undefined and cannot tell that from an errand nobody has finished. Caught here because every other check would pass — the export is well-formed, the profile is spelled correctly, and the level is claimed."
    },
    {
      "id": "profile/a-mapping-is-not-always-a-field",
      "level": 1,
      "op": "validate",
      "given": {
        "type": {
          "id": "t_page",
          "name": "Page",
          "fields": [
            {
              "key": "heading",
              "kind": "text"
            },
            {
              "key": "window",
              "kind": "datespan"
            }
          ],
          "profiles": {
            "task": {
              "title": "heading",
              "start": {
                "field": "window",
                "part": "start"
              },
              "due": {
                "field": "window",
                "part": "end"
              },
              "completeValues": [
                "filed"
              ]
            },
            "note": {
              "title": "heading",
              "body": "content"
            },
            "habit": {
              "streak": "days_running"
            }
          }
        }
      },
      "expect": {
        "valid": true
      },
      "why": "The companion to the case above, and the reason it is safe to run. Three things in a profile are not field keys: a list of complete values, the halves of a compound field named through `{field, part}`, and `content` — the one reserved slot outside the property bag. A profile nobody standardized is carried and not interpreted, so `habit` naming a field this type does not have is not an error either. A rule that fired on any of these would be one producers learn to ignore."
    },
    {
      "id": "profile/contact-email-is-the-mapped-field",
      "level": 1,
      "op": "read",
      "given": {
        "type": {
          "id": "t_person",
          "name": "Person",
          "fields": [
            {
              "key": "name",
              "kind": "text"
            },
            {
              "key": "addresses",
              "kind": "text",
              "many": true
            },
            {
              "key": "works_at",
              "kind": "reference",
              "targetType": "t_org"
            },
            {
              "key": "about",
              "kind": "richtext"
            }
          ],
          "profiles": {
            "contact": {
              "title": "name",
              "email": "addresses",
              "organization": "works_at",
              "body": "about"
            }
          }
        },
        "object": {
          "properties": {
            "name": "Rosa Diaz",
            "addresses": [
              "rosa@nine-nine.example",
              "rd@home.example"
            ]
          }
        }
      },
      "args": {
        "key": "email",
        "profile": "contact"
      },
      "expect": [
        "rosa@nine-nine.example",
        "rd@home.example"
      ],
      "why": "`contact` names its slots as `task` does, so a stranger can find *the* email without being told what this producer calls it — here `addresses`, a `many` field, and both of them: a person with two addresses has two, and the first is not more theirs than the second."
    },
    {
      "id": "profile/event-end-is-half-a-span",
      "level": 1,
      "op": "read",
      "given": {
        "type": {
          "id": "t_meeting",
          "name": "Meeting",
          "fields": [
            {
              "key": "what",
              "kind": "text"
            },
            {
              "key": "when",
              "kind": "datespan",
              "startLabel": "From",
              "endLabel": "Until"
            },
            {
              "key": "where",
              "kind": "text"
            },
            {
              "key": "who",
              "kind": "reference",
              "targetType": "t_person",
              "many": true
            }
          ],
          "profiles": {
            "event": {
              "title": "what",
              "start": {
                "field": "when",
                "part": "start"
              },
              "end": {
                "field": "when",
                "part": "end"
              },
              "location": "where",
              "attendees": "who"
            }
          }
        },
        "object": {
          "properties": {
            "what": "Retreat",
            "when": {
              "start": "2026-03-12T09:00",
              "end": "2026-03-12T16:00"
            }
          }
        }
      },
      "args": {
        "key": "end",
        "profile": "event"
      },
      "expect": "2026-03-12T16:00",
      "why": "An event's `start` and `end` follow the part mapping exactly as a task's `start` and `due` do. One producer's single span is the profile's two ends, and the labels on it — From, Until — are the producer's words, not a vocabulary to match."
    },
    {
      "id": "profile/a-project-says-it-is-one",
      "level": 1,
      "op": "profilesOf",
      "given": {
        "type": {
          "id": "t_initiative",
          "name": "Initiative",
          "fields": [
            {
              "key": "name",
              "kind": "text"
            },
            {
              "key": "why",
              "kind": "richtext"
            }
          ],
          "profiles": {
            "project": {
              "title": "name",
              "body": "why"
            }
          }
        }
      },
      "expect": [
        "project"
      ],
      "why": "A type called Initiative is a project because it says so. Without the profile, the only way a consumer could find someone's projects was by the type's name — which works for an account whose projects are called Projects and fails for every other, and is the guess this format exists to make unnecessary."
    },
    {
      "id": "profile/a-pointing-slot-must-be-a-reference",
      "level": 1,
      "op": "validate",
      "given": {
        "type": {
          "id": "t_todo",
          "name": "Todo",
          "fields": [
            {
              "key": "title",
              "kind": "text"
            },
            {
              "key": "done",
              "kind": "boolean"
            },
            {
              "key": "project_name",
              "kind": "text"
            }
          ],
          "profiles": {
            "task": {
              "title": "title",
              "project": "project_name"
            }
          }
        }
      },
      "expect": {
        "valid": false,
        "errors": [
          {
            "code": "profile.slot-not-a-reference"
          }
        ]
      },
      "why": "`project`, `attendees` and `organizer` exist so a reader can follow them — to the project a task is part of, the people at a meeting. A text field holding a project's name looks the same and leads nowhere: two projects can share a name, one can be renamed, and the link silently becomes a word."
    },
    {
      "id": "profile/attendees-are-references",
      "level": 1,
      "op": "validate",
      "given": {
        "type": {
          "id": "t_meeting",
          "name": "Meeting",
          "fields": [
            {
              "key": "what",
              "kind": "text"
            },
            {
              "key": "when",
              "kind": "datespan",
              "startLabel": "From",
              "endLabel": "Until"
            },
            {
              "key": "where",
              "kind": "text"
            },
            {
              "key": "who",
              "kind": "reference",
              "targetType": "t_person",
              "many": true
            }
          ],
          "profiles": {
            "event": {
              "title": "what",
              "start": {
                "field": "when",
                "part": "start"
              },
              "end": {
                "field": "when",
                "part": "end"
              },
              "location": "where",
              "attendees": "who"
            }
          }
        }
      },
      "expect": {
        "valid": true
      },
      "why": "The companion to the case above: a `many` reference to people is exactly what `attendees` wants. Whether the targets are contacts is their type's to say, not this one's — a meeting can invite a room, and a reader that finds no `contact` on the target reads it as whatever it is."
    }
  ]
}
